.git/
# The image installs its own (npm ci). A host copy would overwrite it with
# whatever this machine happens to have, platform builds included.
**/node_modules/
.env
.env.*
*.log
dump.md
stack.md

# bind-mounted at runtime (compose.yaml), never needed in the image
/static/

# Generated by prexy/build.ts, which the Dockerfile runs itself. A local copy in
# the build context is redundant or wrong: build
# into the image and be served ahead of the static/games/ fallback forever.
apps/server/static/
