PREX_ADMIN_KEY=

# -- Activity store (optional) ---------------------------------------------
# Leave all of this unset and prex runs as a two-container stack: capture,
# triggers, the debug UI and MCP all work exactly as before, nothing is
# persisted, and no ClickHouse container is started.
#
# To enable it, uncomment all four. COMPOSE_PROFILES is what starts the
# clickhouse service; PREX_CLICKHOUSE_URL is what tells prex to use it.
# COMPOSE_PROFILES=store
# PREX_CLICKHOUSE_URL=http://prex-clickhouse:8123
# PREX_CLICKHOUSE_USER=prex
# PREX_CLICKHOUSE_PASSWORD=

# -- Store tuning (optional) -----------------------------------------------
# All optional. Unset uses the default; an unusable value warns at boot and
# falls back rather than refusing to start.

# How often queued activity is flushed to ClickHouse, in milliseconds.
# This sets the part-creation rate exactly: parts/day = 86,400 / interval.
# Default 60000. Lower it only if you need  activity durable sooner and
# can accept the merge cost.
# Anything lost is recorded as a gap, never silently dropped.
# PREX_FLUSH_INTERVAL_MS=60000

# In-memory activity queue depth. Must comfortably cover one flush window plus
# a store hiccup, so raise it alongside a much larger flush interval. Default
# 20000, which at a measured ~8 rows/sec is roughly 41 minutes.
# PREX_INGEST_QUEUE_MAX=20000

# Guardrails for the read-only query_sql MCP tool. Follow the ClickHouse
# container's own memory limit (compose.yaml `mem_limit`). Defaults 512 / 15.
# If queries fail with a TOTAL memory error, the server needs headroom, raising
# this will not help, because the memory was never the query's.
# PREX_SQL_MAX_MEMORY_MB=512
# PREX_SQL_TIMEOUT_SECONDS=15
